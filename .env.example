# All values are optional. The tool works with zero keys.

# Your contact email for Crossref's "polite pool" (strongly recommended).
CROSSREF_MAILTO=

# Semantic Scholar API key (optional). Request one at
# https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex API key (optional but strongly recommended since Feb 2026;
# without it you get a tiny daily testing budget). Free at https://openalex.org/settings/api
OPENALEX_API_KEY=
OPENALEX_MAILTO=

# Elsevier / Scopus API (optional; non-commercial academic use, subject to entitlement).
# Get a key at https://dev.elsevier.com/ ; the institutional token is issued by Elsevier support.
ELSEVIER_API_KEY=
ELSEVIER_INSTTOKEN=

# Where the local SQLite database and downloaded files live (default: ~/.citation-reconciler)
CITATION_RECONCILER_HOME=
